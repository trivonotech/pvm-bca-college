rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin & Users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{document=**} {
      allow read: if request.auth != null;
    }
    
    // Content (Events, News, Students, Courses, etc.)
    match /{collection}/{docId} {
      allow read: if true; // Everyone can see content
      allow write: if request.auth != null; // Only admin edits
    }
    
    // Special: Analytics (Counting Views)
    match /analytics/{docId} {
      allow read: if true;
      allow update: if true; // Public can count views
      allow create: if true;
    }

    // Special: System Logs (Reporting Errors/Weaknesses)
    match /system_logs/{logId} {
      allow create: if true; // Public can report errors
      allow read, delete: if request.auth != null;
    }
    
    // Contacts & Submissions
    match /contacts/{contactId} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }

    // Special: Cross-Device Verification Signals
    match /verification_signals/{userId} {
      allow read: if true; // Waiting device (unauthed) needs to read this
      allow write: if request.auth != null; // Verifying device must be authed
    }
  }
}
